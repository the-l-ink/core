{
  "name": "@the-link/core",
  "version": "0.3.1",
  "description": "Composable bidirectional event routing primitives.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/core.js",
  "types": "dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./decorators": {
      "types": "./dist/decorators/escript.d.ts",
      "default": "./dist/decorators/escript.js"
    },
    "./decorators/legacy": {
      "types": "./dist/decorators/legacy.d.ts",
      "default": "./dist/decorators/legacy.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-l-ink/core.git"
  },
  "homepage": "https://the-l.ink",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "node --run clean && tsc",
    "verify:package": "npm pack --dry-run --ignore-scripts",
    "verify": "node --run check && node --run test && node --run build && node --run verify:package",
    "prepack": "node --run build"
  },
  "dependencies": {
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
